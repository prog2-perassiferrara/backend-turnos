# Mismos nombres de variables que Catálogo, con almacenamiento y puertos propios.
DB_NAME=appointment
DB_USER=appointment
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3307
APP_PORT=8081
# Solo inicializa MySQL; no se entrega al backend.
MYSQL_ROOT_PASSWORD=
# Para Java local. Compose utiliza automáticamente http://catalog:8080.
CATALOG_BASE_URL=http://localhost:8080
CATEDRA_BASE_URL=
CATEDRA_GROUP_ID=
# Archivo privado externo al repositorio; la pública correspondiente se configura en Catálogo.
JWT_PRIVATE_KEY_PATH=
# Opcional: orígenes web explícitos separados por comas. Vacío mantiene CORS cerrado.
CORS_ALLOWED_ORIGINS=
# Opcional: habilita OpenAPI y Swagger UI; false por defecto. Requiere reiniciar/recrear.
# API_DOCS_ENABLED=true
# Opcionales: zona de atención y timeout de conexión/lectura (el total por proveedor es el doble).
AVAILABILITY_TIME_ZONE=America/Argentina/Buenos_Aires
AVAILABILITY_HTTP_TIMEOUT=5s
# Opcional: timeout de conexión/lectura de los clientes de integración con Catálogo y cátedra.
TECHNICAL_INTEGRATION_HTTP_TIMEOUT=5s
# Opcionales: presupuestos HTTP/Kafka y preparación del consumidor de reservas.
RESERVATION_HTTP_TIMEOUT=5s
RESERVATION_METADATA_TIMEOUT=5s
RESERVATION_ATTEMPTS=3
RESERVATION_RETRY_DELAY=5s
RESERVATION_PREPARATION_COOLDOWN=30s
RESERVATION_PHONE_PUBLISH_TIMEOUT=5s
RESERVATION_RESULT_VERIFICATION_DELAY=30s
